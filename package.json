{
  "name": "fantasy-war-room-2026",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A local-first, source-aware 2026 fantasy football draft assistant for GitHub Pages.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "node scripts/clean.mjs",
    "data:refresh": "node scripts/refresh-data.mjs",
    "data:refresh:environment": "node scripts/refresh-data.mjs --environment-only",
    "data:refresh:history": "node scripts/refresh-data.mjs --include-history",
    "data:validate": "node scripts/validate-data.mjs",
    "data:freshness": "node scripts/check-draft-readiness.mjs",
    "lint": "node scripts/lint.mjs",
    "model:lab": "node scripts/model-lab.mjs",
    "test": "node --test",
    "check": "npm run lint && npm run data:validate && npm test && npm run build",
    "draft:ready": "npm run check && npm run data:freshness",
    "serve": "node scripts/serve.mjs dist 4173"
  },
  "engines": {
    "node": ">=20.11"
  }
}
